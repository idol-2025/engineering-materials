/* Responsive adjustments */
@media (max-width: 768px) {
    .table-container {
        max-height: 50vh;
    }
}

/* Print styles */
@media print {
    .no-print {
        display: none;
    }
    
    body {
        background-color: white;
    }
    
    .table-container {
        max-height: none;
        overflow: visible;
    }
}

