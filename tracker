// DOM Elements
const materialsTableBody = document.getElementById('materialsTableBody');
const searchInput = document.getElementById('searchInput');
const noResults = document.getElementById('noResults');
const addMaterialBtn = document.getElementById('addMaterialBtn');
const exportBtn = document.getElementById('exportBtn');
const exportExcelBtn = document.getElementById('exportExcelBtn');
const materialModal = document.getElementById('materialModal');
const modalTitle = document.getElementById('modalTitle');
const materialForm = document.getElementById('materialForm');
const cancelModalBtn = document.getElementById('cancelModalBtn');
const confirmationModal = document.getElementById('confirmationModal');
const cancelDeleteBtn = document.getElementById('cancelDeleteBtn');
const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');

// Stats elements
const totalMaterialsEl = document.getElementById('totalMaterials');
const totalValueEl = document.getElementById('totalValue');
const lowStockCountEl = document.getElementById('lowStockCount');

// Form fields
const materialIdInput = document.getElementById('materialId');
const itemNumberInput = document.getElementById('itemNumber');
const materialNameInput = document.getElementById('materialName');
const materialSpecsInput = document.getElementById('materialSpecs');
const inStockInput = document.getElementById('inStock');
const outStockInput = document.getElementById('outStock');
const unitPriceInput = document.getElementById('unitPrice');
const minStockLevelInput = document.getElementById('minStockLevel');

let materialToDelete = null;

// Generate next item number
function getNextItemNumber() {
    // Find the highest item number
    let maxItemNumber = 10; // Default starting at 000010
    
    materials.forEach(material => {
        const itemNum = parseInt(material.itemNumber);
        if (!isNaN(itemNum) && itemNum > maxItemNumber) {
            maxItemNumber = itemNum;
        }
    });
    
    // Return the next number, formatted as 6 digits
    return String(maxItemNumber + 1).padStart(6, '0');
}

// Initialize the table
function renderTable(data = materials) {
    materialsTableBody.innerHTML = '';
    
    if (data.length === 0) {
        noResults.classList.remove('hidden');
    } else {
        noResults.classList.add('hidden');
        
        data.forEach(material => {
            const row = document.createElement('tr');
            row.className = material.remaining <= material.minStockLevel ? 'bg-amber-50' : '';
            
            row.innerHTML = `
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="font-medium text-gray-900">${material.itemNumber}</div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="font-medium text-gray-900">${material.name}</div>
                </td>
                <td class="px-6 py-4">
                    <div class="text-sm text-gray-900">${material.specifications}</div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900">${material.inStock}</div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900">${material.outStock}</div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm font-medium ${material.remaining <= material.minStockLevel ? 'text-red-600' : 'text-gray-900'}">${material.remaining}</div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <button class="text-blue-600 hover:text-blue-900 mr-3 edit-btn" data-id="${material.id}">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                        </svg>
                    </button>
                    <button class="text-red-600 hover:text-red-900 delete-btn" data-id="${material.id}">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                    </button>
                </td>
            `;
            
            materialsTableBody.appendChild(row);
        });
        
        // Add event listeners to edit and delete buttons
        document.querySelectorAll('.edit-btn').forEach(btn => {
            btn.addEventListener('click', () => editMaterial(parseInt(btn.dataset.id)));
        });
        
        document.querySelectorAll('.delete-btn').forEach(btn => {
            btn.addEventListener('click', () => showDeleteConfirmation(parseInt(btn.dataset.id)));
        });
    }
    
    updateStats();
}

// Search functionality
function searchMaterials(query) {
    if (!query) {
        renderTable();
        return;
    }
    
    const lowerQuery = query.toLowerCase();
    const filteredMaterials = materials.filter(material => {
        return (
            material.itemNumber.includes(lowerQuery) ||
            material.name.toLowerCase().includes(lowerQuery) ||
            material.specifications.toLowerCase().includes(lowerQuery)
        );
    });
    
    renderTable(filteredMaterials);
}

// Update statistics
function updateStats() {
    totalMaterialsEl.textContent = materials.length;
    
    const totalValue = materials.reduce((sum, material) => {
        return sum + (material.remaining * material.unitPrice);
    }, 0);
    totalValueEl.textContent = `$${totalValue.toFixed(2)}`;
    
    const lowStockCount = materials.filter(material => material.remaining <= material.minStockLevel).length;
    lowStockCountEl.textContent = lowStockCount;
}

// Add new material
function showAddMaterialModal() {
    modalTitle.textContent = 'Add New Material';
    materialIdInput.value = '';
    materialForm.reset();
    
    // Generate and set the next item number
    itemNumberInput.value = getNextItemNumber();
    
    materialModal.classList.remove('hidden');
}

// Edit material
function editMaterial(id) {
    const material = materials.find(m => m.id === id);
    if (!material) return;
    
    modalTitle.textContent = 'Edit Material';
    materialIdInput.value = material.id;
    itemNumberInput.value = material.itemNumber;
    materialNameInput.value = material.name;
    materialSpecsInput.value = material.specifications;
    inStockInput.value = material.inStock;
    outStockInput.value = material.outStock;
    unitPriceInput.value = material.unitPrice;
    minStockLevelInput.value = material.minStockLevel;
    
    materialModal.classList.remove('hidden');
}

// Save material (add or update)
function saveMaterial(e) {
    e.preventDefault();
    
    const id = materialIdInput.value ? parseInt(materialIdInput.value) : Date.now();
    const inStock = parseInt(inStockInput.value);
    const outStock = parseInt(outStockInput.value);
    
    const material = {
        id,
        itemNumber: itemNumberInput.value,
        name: materialNameInput.value,
        specifications: materialSpecsInput.value,
        inStock,
        outStock,
        remaining: inStock - outStock,
        unitPrice: parseFloat(unitPriceInput.value),
        minStockLevel: parseInt(minStockLevelInput.value)
    };
    
    if (materialIdInput.value) {
        // Update existing material
        const index = materials.findIndex(m => m.id === id);
        if (index !== -1) {
            materials[index] = material;
        }
    } else {
        // Add new material
        materials.push(material);
    }
    
    materialModal.classList.add('hidden');
    renderTable();
    saveToLocalStorage();
}

// Delete material
function showDeleteConfirmation(id) {
    materialToDelete = id;
    confirmationModal.classList.remove('hidden');
}

function deleteMaterial() {
    if (materialToDelete === null) return;
    
    materials = materials.filter(material => material.id !== materialToDelete);
    materialToDelete = null;
    confirmationModal.classList.add('hidden');
    renderTable();
    saveToLocalStorage();
}

// Export data as JSON
function exportData() {
    const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(materials, null, 2));
    const downloadAnchorNode = document.createElement('a');
    downloadAnchorNode.setAttribute("href", dataStr);
    downloadAnchorNode.setAttribute("download", "engineering_materials.json");
    document.body.appendChild(downloadAnchorNode);
    downloadAnchorNode.click();
    downloadAnchorNode.remove();
}

// Export data as Excel (CSV)
function exportToExcel() {
    // Create CSV content
    let csvContent = "Item Number,Material Name,Specifications,In Stock,Out Stock,Remaining,Unit Price,Min Stock Level\n";
    
    materials.forEach(material => {
        csvContent += `${material.itemNumber},${material.name.replace(/,/g, ";")},${material.specifications.replace(/,/g, ";")},${material.inStock},${material.outStock},${material.remaining},${material.unitPrice},${material.minStockLevel}\n`;
    });
    
    // Create download link
    const encodedUri = encodeURI("data:text/csv;charset=utf-8," + csvContent);
    const link = document.createElement("a");
    link.setAttribute("href", encodedUri);
    link.setAttribute("download", "engineering_materials.csv");
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
}

// Local Storage functions
function saveToLocalStorage() {
    localStorage.setItem('engineeringMaterials', JSON.stringify(materials));
}

function loadFromLocalStorage() {
    const storedMaterials = localStorage.getItem('engineeringMaterials');
    if (storedMaterials) {
        materials = JSON.parse(storedMaterials);
        renderTable();
    }
}

// Event Listeners
searchInput.addEventListener('input', (e) => searchMaterials(e.target.value));
addMaterialBtn.addEventListener('click', showAddMaterialModal);
exportBtn.addEventListener('click', exportData);
exportExcelBtn.addEventListener('click', exportToExcel);
materialForm.addEventListener('submit', saveMaterial);
cancelModalBtn.addEventListener('click', () => materialModal.classList.add('hidden'));
cancelDeleteBtn.addEventListener('click', () => {
    materialToDelete = null;
    confirmationModal.classList.add('hidden');
});
confirmDeleteBtn.addEventListener('click', deleteMaterial);

// Close modals when clicking outside
window.addEventListener('click', (e) => {
    if (e.target === materialModal) {
        materialModal.classList.add('hidden');
    }
    if (e.target === confirmationModal) {
        confirmationModal.classList.add('hidden');
        materialToDelete = null;
    }
});

// Initialize the app
document.addEventListener('DOMContentLoaded', () => {
    loadFromLocalStorage();
    if (materials.length === 0 || !localStorage.getItem('engineeringMaterials')) {
        renderTable(); // Render with sample data if no stored data
    }
});
